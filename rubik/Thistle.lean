/-- The invariants as a group homomorphism. -/
def chi : Cube →* (Multiplicative (ZMod 3) × Multiplicative (ZMod 2)) × ℤˣ where
  toFun s := ((Multiplicative.ofAdd (∑ i, s.co i), Multiplicative.ofAdd (∑ i, s.eo i)),
    Equiv.Perm.sign s.cp * Equiv.Perm.sign s.ep)
  map_one' := by simp
  map_mul' a b := by
    refine Prod.ext (Prod.ext ?_ ?_) ?_
    · simp only [Cube.mul_co, Finset.sum_add_distrib, Prod.mk_mul_mk, ← ofAdd_add]
      rw [Equiv.sum_comp b.cp a.co]
    · simp only [Cube.mul_eo, Finset.sum_add_distrib, Prod.mk_mul_mk, ← ofAdd_add]
      rw [Equiv.sum_comp b.ep a.eo]
    · simp [mul_mul_mul_comm]

theorem chi_eq_one_iff (s : Cube) : chi s = 1 ↔ Valid s := by
  have h : ∀ u v : ℤˣ, u * v = 1 ↔ u = v := by decide
  simp only [chi, MonoidHom.coe_mk, OneHom.coe_mk, Prod.mk_eq_one, ofAdd_eq_one, h, Valid, and_assoc]

theorem chi_surjective : Function.Surjective chi := by
  rintro ⟨⟨a, b⟩, u⟩
  refine ⟨⟨if u = 1 then 1 else Equiv.swap 0 1, Pi.single 0 a.toAdd, 1, Pi.single 0 b.toAdd⟩, ?_⟩
  refine Prod.ext (Prod.ext ?_ ?_) ?_
  · show Multiplicative.ofAdd (∑ i, (Pi.single 0 a.toAdd : Fin 8 → ZMod 3) i) = a
    rw [Finset.sum_pi_single']; simp
  · show Multiplicative.ofAdd (∑ i, (Pi.single 0 b.toAdd : Fin 12 → ZMod 2) i) = b
    rw [Finset.sum_pi_single']; simp
  · show Equiv.Perm.sign (if u = 1 then 1 else Equiv.swap (0 : Fin 8) 1) * Equiv.Perm.sign (1 : Equiv.Perm (Fin 12)) = u
    rcases Int.units_eq_one_or u with rfl | rfl <;> simp

theorem card_valid : Nat.card {s // Valid s} = 43252003274489856000 := by
  have h1 : Nat.card chi.ker * chi.ker.index = Nat.card Cube := Subgroup.card_mul_index _
  have h2 : chi.ker.index = 12 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr chi_surjective]
    simp [Nat.card_eq_fintype_card]
  have h3 : Nat.card chi.ker = Nat.card {s // Valid s} :=
    Nat.card_congr (Equiv.subtypeEquivRight fun s => by rw [MonoidHom.mem_ker, chi_eq_one_iff])
  rw [h2, h3, Nat.card_eq_fintype_card (α := Cube), Cube.card_cube] at h1
  have : Nat.factorial 8 * 3 ^ 8 * (Nat.factorial 12 * 2 ^ 12) = 43252003274489856000 * 12 := by
    norm_num [Nat.factorial]
  rw [this] at h1
  exact Nat.eq_of_mul_eq_mul_right (by norm_num) h1

/-! ## Stage 3b: counting canonical move sequences

A sequence is canonical if no two consecutive moves turn the same face and, for two
consecutive moves on opposite faces, the `U`/`R`/`F` one comes first.  `C k o` is the set of
states produced by canonical sequences of length `k` whose last face is `o`. -/

def axis : Face → Fin 3 | .U => 0 | .D => 0 | .R => 1 | .L => 1 | .F => 2 | .B => 2
def hi : Face → Bool | .U => false | .D => true | .R => false | .L => true | .F => false | .B => true

/-- May a move of face `f` follow a move of face `o` (or start the sequence, `o = none`)? -/
def allowed : Option Face → Face → Bool
  | none, _ => true
  | some g, f => decide (axis g ≠ axis f) || (!hi g && hi f)

def C : ℕ → Option Face → Finset Cube
  | 0, none => {1}
  | 0, some _ => ∅
  | _ + 1, none => ∅
  | k + 1, some f => (Finset.univ.filter (fun o => allowed o f = true)).biUnion fun o =>
      (C k o).biUnion fun s => Finset.univ.image fun j : Fin 3 => s * q f ^ (j.val + 1)

theorem mem_C_succ {k : ℕ} {f : Face} {s : Cube} : s ∈ C (k + 1) (some f) ↔
    ∃ o, allowed o f = true ∧ ∃ t ∈ C k o, ∃ j : Fin 3, t * q f ^ (j.val + 1) = s := by
  simp [C]

theorem mem_succ {k : ℕ} {o : Option Face} {f : Face} {t : Cube} (j : Fin 3)
    (ha : allowed o f = true) (ht : t ∈ C k o) : t * q f ^ (j.val + 1) ∈ C (k + 1) (some f) :=
  mem_C_succ.mpr ⟨o, ha, t, ht, j, rfl⟩

theorem pow_merge (f : Face) (i j : Fin 3) : q f ^ (i.val + 1) * q f ^ (j.val + 1) = 1 ∨
    ∃ j' : Fin 3, q f ^ (i.val + 1) * q f ^ (j.val + 1) = q f ^ (j'.val + 1) := by
  rw [← pow_add, pow_eq_pow_mod (i.val + 1 + (j.val + 1)) (q_pow_four f)]
  have : (i.val + 1 + (j.val + 1)) % 4 < 4 := Nat.mod_lt _ (by norm_num)
  generalize (i.val + 1 + (j.val + 1)) % 4 = n at this
  interval_cases n
  · left; simp
  · right; exact ⟨0, rfl⟩
  · right; exact ⟨1, rfl⟩
  · right; exact ⟨2, rfl⟩

/-- Turns of opposite faces commute. -/
theorem bad_comm : ∀ g f, allowed (some g) f = false → g ≠ f → q g * q f = q f * q g := by
  decide +kernel
theorem bad_allowed : ∀ g f, allowed (some g) f = false → g ≠ f → allowed (some f) g = true := by
  decide
theorem bad_pred : ∀ o g f, allowed (some g) f = false → g ≠ f → allowed o g = true →
    o ≠ some f → allowed o f = true := by decide
theorem bad_pred' : ∀ o g f, allowed (some g) f = false → g ≠ f → allowed o f = true →
    allowed o g = true := by decide

/-- Appending a move to a canonical sequence gives a state that has a canonical sequence which
is not longer (merge equal faces, sort opposite faces). -/
theorem C_step {k : ℕ} {o : Option Face} {s : Cube} (hs : s ∈ C k o) (f : Face) (j : Fin 3) :
    ∃ k' ≤ k + 1, ∃ o', s * q f ^ (j.val + 1) ∈ C k' o' := by
  rcases o with _ | g
  · exact ⟨k + 1, le_rfl, some f, mem_succ j rfl hs⟩
  by_cases ha : allowed (some g) f = true
  · exact ⟨k + 1, le_rfl, some f, mem_succ j ha hs⟩
  rw [Bool.not_eq_true] at ha
  rcases k with _ | k0
  · simp [C] at hs
  obtain ⟨o0, ha0, t, ht, i, rfl⟩ := mem_C_succ.mp hs
  by_cases hgf : g = f
  · subst hgf
    rw [mul_assoc]
    rcases pow_merge g i j with h | ⟨j', h⟩
    · rw [h, mul_one]; exact ⟨k0, by omega, o0, ht⟩
    · rw [h]; exact ⟨k0 + 1, by omega, some g, mem_succ j' ha0 ht⟩
  have comm : q g ^ (i.val + 1) * q f ^ (j.val + 1) = q f ^ (j.val + 1) * q g ^ (i.val + 1) :=
    ((show Commute (q g) (q f) from bad_comm g f ha hgf).pow_pow _ _).eq
  rw [mul_assoc, comm, ← mul_assoc]
  by_cases h0 : o0 = some f
  · subst h0
    rcases k0 with _ | k1
    · simp [C] at ht
    obtain ⟨o1, ha1, u, hu, i2, rfl⟩ := mem_C_succ.mp ht
    rw [mul_assoc u]
    rcases pow_merge f i2 j with h | ⟨j', h⟩
    · rw [h, mul_one]
      exact ⟨k1 + 1, by omega, some g, mem_succ i (bad_pred' o1 g f ha hgf ha1) hu⟩
    · rw [h]
      exact ⟨k1 + 2, by omega, some g, mem_succ i (bad_allowed g f ha hgf) (mem_succ j' ha1 hu)⟩
  · have h1 : allowed o0 f = true := bad_pred o0 g f ha hgf ha0 h0
    exact ⟨k0 + 2, le_rfl, some g, mem_succ i (bad_allowed g f ha hgf) (mem_succ j h1 ht)⟩

/-- Every state produced by a sequence of length `n` lies in some `C k o` with `k ≤ n`. -/
theorem evalSeq_mem_C (l : List Move) : ∃ k ≤ l.length, ∃ o, evalSeq l ∈ C k o := by
  induction l using List.reverseRecOn with
  | nil => exact ⟨0, le_rfl, none, by simp [C, evalSeq]⟩
  | append_singleton l m ih =>
    obtain ⟨k, hk, o, h⟩ := ih
    obtain ⟨k', hk', o', h'⟩ := C_step h m.face m.k
    refine ⟨k', ?_, o', ?_⟩
    · simp only [List.length_append, List.length_singleton]; omega
    · rw [evalSeq_append, evalSeq_singleton]; exact h'

/-- `(bd k) = (n, a, b)`: bounds for `|C k none|`, `|C k (some f)|` for `f ∈ {U,R,F}`, resp.
`f ∈ {D,L,B}`. -/
def bd : ℕ → ℕ × ℕ × ℕ
  | 0 => (1, 0, 0)
  | k + 1 => (0, 3 * ((bd k).1 + 2 * (bd k).2.1 + 2 * (bd k).2.2),
      3 * ((bd k).1 + 3 * (bd k).2.1 + 2 * (bd k).2.2))

def N (k : ℕ) : Option Face → ℕ
  | none => (bd k).1
  | some f => if hi f then (bd k).2.2 else (bd k).2.1

theorem face_sum (g : Face → ℕ) : ∑ f, g f = g .U + g .D + g .R + g .L + g .F + g .B := by
  show Finset.sum {Face.U, .D, .R, .L, .F, .B} g = _
  simp [Finset.sum_insert, add_assoc]

theorem card_C_le : ∀ k o, (C k o).card ≤ N k o := by
  intro k
  induction k with
  | zero => intro o; cases o <;> simp [C, N, bd]
  | succ k ih =>
    intro o
    rcases o with _ | f
    · simp [C]
    calc (C (k + 1) (some f)).card
        ≤ ∑ o ∈ Finset.univ.filter (fun o => allowed o f = true), 3 * N k o := by
          unfold C
          refine Finset.card_biUnion_le.trans (Finset.sum_le_sum fun o _ => ?_)
          refine Finset.card_biUnion_le.trans ?_
          calc ∑ s ∈ C k o, (Finset.univ.image fun j : Fin 3 => s * q f ^ (j.val + 1)).card
              ≤ ∑ _s ∈ C k o, 3 := Finset.sum_le_sum fun s _ => by
                  simpa using Finset.card_image_le (s := (Finset.univ : Finset (Fin 3)))
                    (f := fun j : Fin 3 => s * q f ^ (j.val + 1))
            _ = (C k o).card * 3 := by simp
            _ ≤ 3 * N k o := by have := ih o; omega
      _ = N (k + 1) (some f) := by
          rw [Finset.sum_filter, Fintype.sum_option, face_sum]
          cases f <;> simp [allowed, axis, hi, N, bd] <;> ring

/-- All states at distance at most `n`. -/
def ball (n : ℕ) : Finset Cube :=
  (Finset.range (n + 1)).biUnion fun k => Finset.univ.biUnion fun o => C k o

/-- Number of canonical sequences of length at most `n`: `1, 19, 262, 3502, …`. -/
def tot : ℕ → ℕ
  | 0 => 1
  | k + 1 => tot k + ((bd (k + 1)).1 + 3 * (bd (k + 1)).2.1 + 3 * (bd (k + 1)).2.2)

theorem card_ball_le (n : ℕ) : (ball n).card ≤ tot n := by
  have h1 : ∀ k, (Finset.univ.biUnion fun o => C k o).card
      ≤ (bd k).1 + 3 * (bd k).2.1 + 3 * (bd k).2.2 := by
    intro k
    refine Finset.card_biUnion_le.trans ((Finset.sum_le_sum fun o _ => card_C_le k o).trans ?_)
    rw [Fintype.sum_option, face_sum]
    simp [N, hi]; omega
  have h2 : ∀ n, ∑ k ∈ Finset.range (n + 1), ((bd k).1 + 3 * (bd k).2.1 + 3 * (bd k).2.2) = tot n := by
    intro n
    induction n with
    | zero => simp [bd, tot]
    | succ n ih => rw [Finset.sum_range_succ, ih]; rfl
  exact Finset.card_biUnion_le.trans ((Finset.sum_le_sum fun k _ => h1 k).trans (h2 n).le)

theorem mem_ball_of_dist_le {s : Cube} {n : ℕ} (hs : Reachable s) (h : dist s ≤ n) : s ∈ ball n := by
  obtain ⟨l, hl, rfl⟩ := dist_spec hs
  obtain ⟨k, hk, o, hC⟩ := evalSeq_mem_C l
  simp only [ball, Finset.mem_biUnion, Finset.mem_range, Finset.mem_univ, true_and]
  exact ⟨k, by omega, o, hC⟩

theorem subset_ball (P : Finset Cube) (n : ℕ) (h : ∀ s ∈ P, Reachable s ∧ dist s ≤ n) :
    P ⊆ ball n := fun s hs => mem_ball_of_dist_le (h s hs).1 (h s hs).2

theorem tot_17 : tot 17 = 19973266111335481264 := by decide +kernel

/-- At most `19973266111335481264` states are within 17 moves of the solved cube. -/
theorem card_ball_17 : (ball 17).card ≤ 19973266111335481264 := tot_17 ▸ card_ball_le 17

/-! ## Main results -/

/-- **A state is reachable by face turns iff it satisfies the three invariants.** -/
theorem reachable_iff_valid (s : Cube) : Reachable s ↔ Valid s := by
  classical
  refine ⟨Reachable.valid, fun hs => ?_⟩
  obtain ⟨P, hP, hcard⟩ := exists_reachable_finset
  have hsub : P ⊆ Finset.univ.filter Valid := fun x hx => by
    simpa using (hP x hx).1.valid
  have hV : (Finset.univ.filter Valid).card = 43252003274489856000 := by
    rw [← card_valid, Nat.card_eq_fintype_card, Fintype.card_subtype]
  have := Finset.eq_of_subset_of_card_le hsub (by rw [hV, hcard])
  exact (hP s (this ▸ by simpa using hs)).1

/-- **The cube group has `43252003274489856000 = 8! * 3^7 * 12! * 2^10` elements.** -/
theorem card_reachable : Nat.card {s // Reachable s} = 43252003274489856000 := by
  rw [← card_valid]
  exact Nat.card_congr (Equiv.subtypeEquivRight reachable_iff_valid)

/-- Every reachable state can be solved in at most `164` moves (stabilizer-chain bound). -/
theorem dist_le_of_reachable {s : Cube} (hs : Reachable s) : dist s ≤ 164 := by
  classical
  obtain ⟨P, hP, hcard⟩ := exists_reachable_finset
  have hsub : P ⊆ Finset.univ.filter Valid := fun x hx => by
    simpa using (hP x hx).1.valid
  have hV : (Finset.univ.filter Valid).card = 43252003274489856000 := by
    rw [← card_valid, Nat.card_eq_fintype_card, Fintype.card_subtype]
  have := Finset.eq_of_subset_of_card_le hsub (by rw [hV, hcard])
  exact (hP s (this ▸ by simpa using hs.valid)).2

/-- Some reachable state needs at least 18 moves. -/
theorem exists_dist_ge_18 : ∃ s, Reachable s ∧ 18 ≤ dist s := by
  obtain ⟨P, hP, hcard⟩ := exists_reachable_finset
  by_contra hcon
  have hsub : P ⊆ ball 17 := subset_ball P 17 fun s hs => by
    refine ⟨(hP s hs).1, ?_⟩
    by_contra h
    exact hcon ⟨s, (hP s hs).1, by omega⟩
  have := (Finset.card_le_card hsub).trans card_ball_17
  rw [hcard] at this
  omega

/-- **God's number of the 3x3x3 cube in the half-turn metric is at least 18.** -/
theorem eighteen_le_godsNumber : 18 ≤ godsNumber :=
  (le_godsNumber_iff 18).mpr exists_dist_ge_18

/-- God's number is at most `164` (a weak, but fully kernel-checked, upper bound). -/
theorem godsNumber_le : godsNumber ≤ 164 :=
  (godsNumber_le_iff _).mpr fun _ hs => dist_le_of_reachable hs

/-- The half-turn-metric God's number lies in `[18, 164]`. -/
theorem godsNumber_bounds : 18 ≤ godsNumber ∧ godsNumber ≤ 164 :=
  ⟨eighteen_le_godsNumber, godsNumber_le⟩

end Rubik


namespace Rubik

/-! ## Stage 4: a Thistlethwaite-style subgroup chain and the upper bound

The chain is `G ⊃ {eo = 0} ⊃ {eo = 0, E slice preserved} ⊃ ⟨U,D,R2,L2,F2,B2⟩ ⊃ (a subgroup with the
corner and edge pattern of the squares group ⟨U2,D2,R2,L2,F2,B2⟩) ⊃ {corners solved} ⊃ 1`.  For each step a table of coset representatives (found by breadth-first
search outside Lean) is checked by the kernel: every word lies in the right subgroup, is short,
and the words have pairwise distinct values of a key that is constant on cosets.  The product of
the table sizes is the order of the cube group, so every reachable state is a product of one
representative per level. -/

/-- Code of an oriented cubie position: corners `3 * pos + ori`, edges `24 + 2 * pos + ori`. -/
def codeOf : PtImg → ℕ
  | .inl x => 3 * x.1.val + x.2.val
  | .inr x => 24 + 2 * x.1.val + x.2.val

def faceOfNat : ℕ → Face
  | 0 => .U | 1 => .D | 2 => .R | 3 => .L | 4 => .F | _ => .B

/-- Moves numbered `3 * face + k`. -/
def mvOfNat (n : ℕ) : Move := ⟨faceOfNat (n % 18 / 3), ⟨n % 3, Nat.mod_lt _ (by norm_num)⟩⟩

/-- The value of a word given by move numbers. -/
def evalW (w : List ℕ) : Cube := evalSeq (w.map mvOfNat)

theorem evalW_cons (m : ℕ) (w : List ℕ) : evalW (m :: w) = (mvOfNat m).toCube * evalW w := by
  simp [evalW, evalSeq]

theorem reachable_evalW (w : List ℕ) : Reachable (evalW w) := ⟨_, rfl⟩

theorem dist_evalW_le (w : List ℕ) : dist (evalW w) ≤ w.length := by
  simpa [evalW] using dist_le (w.map mvOfNat)

def allTab : ℕ := 

/-- One move applied to a code: a table lookup made of kernel-accelerated `Nat` operations. -/
def stepN (m c : ℕ) : ℕ := (allTab >>> (6 * (48 * (m % 18) + c))) % 64

theorem stepN_spec : ∀ (k : Fin 18) (x : PtImg),
    codeOf (act (mvOfNat k.val).toCube x) = stepN k.val (codeOf x) := by decide +kernel

theorem stepN_spec' (n : ℕ) (x : PtImg) :
    codeOf (act (mvOfNat n).toCube x) = stepN n (codeOf x) := by
  have h := stepN_spec ⟨n % 18, Nat.mod_lt _ (by norm_num)⟩ x
  have h1 : mvOfNat (n % 18) = mvOfNat n := by
    simp [mvOfNat, Nat.mod_mod_of_dvd n (by norm_num : 3 ∣ 18)]
  have h2 : stepN (n % 18) = stepN n := by funext c; simp [stepN]
  simpa only [h1, h2] using h

/-- Track a code through a word (raw recursor: fast in the kernel). -/
noncomputable def trackN (w : List ℕ) (c : ℕ) : ℕ :=
  @List.rec ℕ (fun _ => ℕ) c (fun m _ ih => stepN m ih) w

theorem act_one (x : PtImg) : act 1 x = x := by
  rcases x with ⟨p, o⟩ | ⟨p, o⟩ <;> simp [act]

theorem trackN_spec (w : List ℕ) (x : PtImg) : trackN w (codeOf x) = codeOf (act (evalW w) x) := by
  induction w with
  | nil => show codeOf x = _; rw [show evalW [] = 1 from rfl, act_one]
  | cons m w ih =>
    rw [evalW_cons, act_mul, stepN_spec', ← ih]; rfl

def cb (p : Pt) : ℕ := codeOf (base p)

def allPts : List Pt := [.inl 0, .inl 1, .inl 2, .inl 3, .inl 4, .inl 5, .inl 6, .inl 7,
  .inr 0, .inr 1, .inr 2, .inr 3, .inr 4, .inr 5, .inr 6, .inr 7, .inr 8, .inr 9, .inr 10, .inr 11]

def baseCodes : List ℕ := [0, 3, 6, 9, 12, 15, 18, 21, 24, 26, 28, 30, 32, 34, 36, 38, 40, 42, 44, 46]

theorem baseCodes_eq : baseCodes = allPts.map cb := by decide
theorem univ_eq_allPts : (Finset.univ : Finset Pt) = allPts.toFinset := by decide
theorem mem_allPts (p : Pt) : p ∈ allPts := List.mem_toFinset.mp (univ_eq_allPts ▸ Finset.mem_univ p)

theorem sum_allPts (F : Pt → ℕ) : ∑ p, F p = (allPts.map F).sum := by
  rw [univ_eq_allPts, List.sum_toFinset _ (by decide : allPts.Nodup)]

/-- Subgroup membership test, stated on the abstract state. -/
def memG (cN : ℕ → ℕ → Bool) (s : Cube) : Prop := ∀ p : Pt, cN (cb p) (codeOf (img s p)) = true

/-- Coset key, stated on the abstract state. -/
def keyG (gN : ℕ → ℕ → ℕ) (s : Cube) : ℕ := ∑ p : Pt, gN (cb p) (codeOf (img s p))

/-- Membership test and key computed from a tracking function `tr` (code of a cubie ↦ code of its
image); raw recursors for kernel speed. -/
noncomputable def memT (cN : ℕ → ℕ → Bool) (tr : ℕ → ℕ) : Bool :=
  @List.rec ℕ (fun _ => Bool) true (fun b _ ih => cN b (tr b) && ih) baseCodes

noncomputable def keyT (gN : ℕ → ℕ → ℕ) (tr : ℕ → ℕ) : ℕ :=
  @List.rec ℕ (fun _ => ℕ) 0 (fun b _ ih => gN b (tr b) + ih) baseCodes

noncomputable def memW (cN : ℕ → ℕ → Bool) (w : List ℕ) : Bool := memT cN (trackN w)

noncomputable def keyW (gN : ℕ → ℕ → ℕ) (w : List ℕ) : ℕ := keyT gN (trackN w)

theorem rec_and (f : ℕ → Bool) (l : List ℕ) :
    @List.rec ℕ (fun _ => Bool) true (fun b _ ih => f b && ih) l = l.all f := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.all_cons, ← ih]

theorem rec_sum (f : ℕ → ℕ) (l : List ℕ) :
    @List.rec ℕ (fun _ => ℕ) 0 (fun b _ ih => f b + ih) l = (l.map f).sum := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.map_cons, List.sum_cons, ← ih]

theorem trackN_cb (w : List ℕ) (p : Pt) : trackN w (cb p) = codeOf (img (evalW w) p) :=
  trackN_spec w (base p)

theorem memW_spec {cN : ℕ → ℕ → Bool} {w : List ℕ} (h : memW cN w = true) : memG cN (evalW w) := by
  intro p
  rw [memW, memT, rec_and, baseCodes_eq, List.all_eq_true] at h
  have := h (cb p) (List.mem_map_of_mem (mem_allPts p))
  rwa [trackN_cb] at this

theorem keyW_spec (gN : ℕ → ℕ → ℕ) (w : List ℕ) : keyW gN w = keyG gN (evalW w) := by
  rw [keyW, keyT, rec_sum, baseCodes_eq, List.map_map, keyG, sum_allPts]
  congr 1
  refine List.map_congr_left fun p _ => ?_
  simp only [Function.comp, trackN_cb]

/-- The key is invariant under right multiplication by `y` as soon as its weights are. -/
theorem keyG_mul (gN : ℕ → ℕ → ℕ) (x y : Cube)
    (hc : ∀ (i c : Fin 8) (o : ZMod 3), gN (cb (.inl i)) (codeOf (.inl (c, o + y.co i))) =
      gN (cb (.inl (y.cp i))) (codeOf (.inl (c, o))))
    (he : ∀ (j c : Fin 12) (o : ZMod 2), gN (cb (.inr j)) (codeOf (.inr (c, o + y.eo j))) =
      gN (cb (.inr (y.ep j))) (codeOf (.inr (c, o)))) :
    keyG gN (x * y) = keyG gN x := by
  unfold keyG
  rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
  congr 1
  · have : ∀ i, gN (cb (.inl i)) (codeOf (img (x * y) (.inl i))) =
        (fun k => gN (cb (.inl k)) (codeOf (img x (.inl k)))) (y.cp i) := by
      intro i
      simp only [img, act, base, Cube.mul_cp, Cube.mul_co, Equiv.Perm.mul_apply, add_zero]
      exact hc i _ _
    simp only [this]
    exact Equiv.sum_comp y.cp (fun k => gN (cb (.inl k)) (codeOf (img x (.inl k))))
  · have : ∀ j, gN (cb (.inr j)) (codeOf (img (x * y) (.inr j))) =
        (fun k => gN (cb (.inr k)) (codeOf (img x (.inr k)))) (y.ep j) := by
      intro j
      simp only [img, act, base, Cube.mul_ep, Cube.mul_eo, Equiv.Perm.mul_apply, add_zero]
      exact he j _ _
    simp only [this]
    exact Equiv.sum_comp y.ep (fun k => gN (cb (.inr k)) (codeOf (img x (.inr k))))

/-- One step of a general subgroup chain. -/
theorem chain_step2 (H H' : Cube → Prop) (K : Cube → ℕ) (d D : ℕ)
    (hclos : ∀ x y, H x → H' y → H (x * y)) (hinv : ∀ x y, H' y → K (x * y) = K x)
    (ws : List (List ℕ)) (hws : ∀ w ∈ ws, H (evalW w) ∧ w.length ≤ d)
    (hnd : (ws.map (fun w => K (evalW w))).Nodup)
    (P : Finset Cube) (hP : ∀ s ∈ P, (Reachable s ∧ dist s ≤ D) ∧ H' s) :
    ∃ P' : Finset Cube, (∀ s ∈ P', (Reachable s ∧ dist s ≤ d + D) ∧ H s) ∧
      P'.card = ws.length * P.card := by
  classical
  set L : List Cube := ws.map evalW with hL
  have hnd' : (L.map K).Nodup := by rw [hL, List.map_map]; exact hnd
  have hLnd : L.Nodup := List.Nodup.of_map _ hnd'
  refine ⟨Finset.image₂ (· * ·) L.toFinset P, ?_, ?_⟩
  · intro s hs
    obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_image₂.mp hs
    rw [List.mem_toFinset] at hx
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hx
    have hd : dist (evalW w * y) ≤ d + D :=
      (dist_mul_le (reachable_evalW w) (hP y hy).1.1).trans
        (Nat.add_le_add ((dist_evalW_le w).trans (hws w hw).2) (hP y hy).1.2)
    exact ⟨⟨(reachable_evalW w).mul (hP y hy).1.1, hd⟩, hclos _ _ (hws w hw).1 (hP y hy).2⟩
  · rw [← List.length_map (as := ws) evalW, ← hL, ← List.toFinset_card_of_nodup hLnd]
    refine Finset.card_image₂_iff.mpr ?_
    rintro ⟨x, y⟩ hxy ⟨x', y'⟩ hxy' e
    change x * y = x' * y' at e
    simp only [Set.mem_prod, Finset.mem_coe, List.mem_toFinset] at hxy hxy'
    have e1 : K x = K x' := by
      rw [← hinv x y (hP y hxy.2).2, e, hinv x' y' (hP y' hxy'.2).2]
    have e2 : x = x' := List.inj_on_of_nodup_map hnd' hxy.1 hxy'.1 e1
    subst e2
    rw [mul_left_cancel e]

/-! ### Kernel-checkable chunks of a table -/

/-- The keys are strictly increasing and lie in `[lo, hi)`. -/
def sortedIn : ℕ → ℕ → List ℕ → Bool
  | lo, hi, [] => decide (lo ≤ hi)
  | lo, hi, k :: ks => decide (lo ≤ k) && sortedIn (k + 1) hi ks

theorem sortedIn_spec : ∀ (ks : List ℕ) (lo hi : ℕ), sortedIn lo hi ks = true →
    ks.Pairwise (· < ·) ∧ (∀ k ∈ ks, lo ≤ k ∧ k < hi) ∧ lo ≤ hi := by
  intro ks
  induction ks with
  | nil => intro lo hi h; simpa [sortedIn] using h
  | cons k ks ih =>
    intro lo hi h
    simp only [sortedIn, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨h1, h2, h3⟩ := ih _ _ h.2
    refine ⟨List.pairwise_cons.mpr ⟨fun k' hk' => (h2 k' hk').1, h1⟩, ?_, by omega⟩
    intro k' hk'
    rcases List.mem_cons.mp hk' with rfl | hk'
    · exact ⟨h.1, by omega⟩
    · have := h2 k' hk'; exact ⟨by omega, this.2⟩

/-- A chunk of a table: all words are in the subgroup `memG cN`, have length at most `d`, and
their keys are strictly increasing inside `[lo, hi)`. -/
def ChunkP (cN : ℕ → ℕ → Bool) (K : Cube → ℕ) (d lo hi : ℕ) (ws : List (List ℕ)) : Prop :=
  (∀ w ∈ ws, memG cN (evalW w) ∧ w.length ≤ d) ∧
  (ws.map (fun w => K (evalW w))).Pairwise (· < ·) ∧
  (∀ w ∈ ws, lo ≤ K (evalW w) ∧ K (evalW w) < hi) ∧ lo ≤ hi

noncomputable def chunkCheck (cN : ℕ → ℕ → Bool) (KW : List ℕ → ℕ) (d lo hi : ℕ)
    (ws : List (List ℕ)) : Bool :=
  ws.all (fun w => memW cN w && decide (w.length ≤ d)) && sortedIn lo hi (ws.map KW)

theorem chunkCheck_spec {cN : ℕ → ℕ → Bool} {KW : List ℕ → ℕ} {K : Cube → ℕ} {d lo hi : ℕ}
    {ws : List (List ℕ)} (hK : ∀ w, KW w = K (evalW w))
    (h : chunkCheck cN KW d lo hi ws = true) : ChunkP cN K d lo hi ws := by
  simp only [chunkCheck, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  obtain ⟨h1, h2⟩ := h
  obtain ⟨s1, s2, s3⟩ := sortedIn_spec _ _ _ h2
  have e : ws.map KW = ws.map (fun w => K (evalW w)) := List.map_congr_left fun w _ => hK w
  rw [e] at s1 s2
  refine ⟨fun w hw => ⟨memW_spec (h1 w hw).1, (h1 w hw).2⟩, s1, fun w hw => ?_, s3⟩
  exact s2 _ (List.mem_map_of_mem (f := fun w => K (evalW w)) hw)

/-! Words packed into numerals (base 32, digit = move number + 1, first move least significant):
this keeps the source small.  `trackP` tracks a code through a packed word directly. -/

def wordAux : ℕ → ℕ → List ℕ
  | 0, _ => []
  | _ + 1, 0 => []
  | f + 1, m + 1 => ((m + 1) % 32 - 1) :: wordAux f ((m + 1) / 32)

def wordOf (n : ℕ) : List ℕ := wordAux 40 n

noncomputable def trackP (fuel : ℕ) : ℕ → ℕ → ℕ :=
  @Nat.rec (fun _ => ℕ → ℕ → ℕ) (fun _ c => c)
    (fun _ ih n c => @Nat.rec (fun _ => ℕ) c
      (fun m _ => stepN ((m + 1) % 32 - 1) (ih ((m + 1) / 32) c)) n) fuel

theorem trackP_eq_aux : ∀ (fuel n c : ℕ), trackP fuel n c = trackN (wordAux fuel n) c := by
  intro fuel
  induction fuel with
  | zero => intro n c; rfl
  | succ f ih =>
    intro n c
    cases n with
    | zero => rfl
    | succ m =>
      show stepN ((m + 1) % 32 - 1) (trackP f ((m + 1) / 32) c) = _
      rw [ih]; rfl

theorem trackP_eq (n : ℕ) : trackP 40 n = trackN (wordOf n) := funext fun c => trackP_eq_aux 40 n c

noncomputable def chunkCheckP (cN : ℕ → ℕ → Bool) (KT : (ℕ → ℕ) → ℕ) (d lo hi : ℕ)
    (ns : List ℕ) : Bool :=
  ns.all (fun n => memT cN (trackP 40 n) && decide ((wordOf n).length ≤ d)) &&
    sortedIn lo hi (ns.map (fun n => KT (trackP 40 n)))

theorem chunkCheckP_spec {cN : ℕ → ℕ → Bool} {KT : (ℕ → ℕ) → ℕ} {K : Cube → ℕ} {d lo hi : ℕ}
    {ns : List ℕ} (hK : ∀ w, KT (trackN w) = K (evalW w))
    (h : chunkCheckP cN KT d lo hi ns = true) : ChunkP cN K d lo hi (ns.map wordOf) := by
  refine chunkCheck_spec (KW := fun w => KT (trackN w)) hK ?_
  simp only [chunkCheckP, trackP_eq] at h
  simpa only [chunkCheck, memW, List.all_map, List.map_map, Function.comp_def] using h

theorem ChunkP.append {cN : ℕ → ℕ → Bool} {K : Cube → ℕ} {d lo mid hi : ℕ} {a b : List (List ℕ)}
    (ha : ChunkP cN K d lo mid a) (hb : ChunkP cN K d mid hi b) : ChunkP cN K d lo hi (a ++ b) := by
  obtain ⟨a1, a2, a3, a4⟩ := ha
  obtain ⟨b1, b2, b3, b4⟩ := hb
  refine ⟨?_, ?_, ?_, a4.trans b4⟩
  · intro w hw
    rcases List.mem_append.mp hw with h | h
    exacts [a1 w h, b1 w h]
  · rw [List.map_append, List.pairwise_append]
    refine ⟨a2, b2, ?_⟩
    intro x hx y hy
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hx
    obtain ⟨w', hw', rfl⟩ := List.mem_map.mp hy
    exact (a3 w hw).2.trans_le (b3 w' hw').1
  · intro w hw
    rcases List.mem_append.mp hw with h | h
    · exact ⟨(a3 w h).1, (a3 w h).2.trans_le b4⟩
    · exact ⟨a4.trans (b3 w h).1, (b3 w h).2⟩

/-- A fully checked table gives one step of the chain. -/
theorem level_step (cN : ℕ → ℕ → Bool) (K : Cube → ℕ) (d hi : ℕ) (H H' : Cube → Prop)
    (hclos : ∀ x y, H x → H' y → H (x * y)) (hinv : ∀ x y, H' y → K (x * y) = K x)
    (ws : List (List ℕ)) (hck : ChunkP cN K d 0 hi ws)
    (hH : ∀ w ∈ ws, memG cN (evalW w) → H (evalW w)) (D : ℕ)
    (P : Finset Cube) (hP : ∀ s ∈ P, (Reachable s ∧ dist s ≤ D) ∧ H' s) :
    ∃ P' : Finset Cube, (∀ s ∈ P', (Reachable s ∧ dist s ≤ d + D) ∧ H s) ∧
      P'.card = ws.length * P.card :=
  chain_step2 H H' K d D hclos hinv ws (fun w hw => ⟨hH w hw (hck.1 w hw).1, (hck.1 w hw).2⟩)
    (hck.2.1.imp (fun h => Nat.ne_of_lt h)) P hP

theorem dist_le_of_finset {B : ℕ} (hex : ∃ P : Finset Cube, (∀ s ∈ P, Reachable s ∧ dist s ≤ B) ∧
    P.card = 43252003274489856000) {s : Cube} (hs : Reachable s) : dist s ≤ B := by
  classical
  obtain ⟨P, hP, hcard⟩ := hex
  have hsub : P ⊆ Finset.univ.filter Valid := fun x hx => by
    simpa using (hP x hx).1.valid
  have hV : (Finset.univ.filter Valid).card = 43252003274489856000 := by
    rw [← card_valid, Nat.card_eq_fintype_card, Fintype.card_subtype]
  have := Finset.eq_of_subset_of_card_le hsub (by rw [hV, hcard])
  exact (hP s (this ▸ by simpa using hs.valid)).2

/-! ### The six levels: subgroups, membership tests and keys -/

def tetF (i : Fin 8) : Bool := (165 >>> i.val) % 2 == 1
def msF (j : Fin 12) : Bool := (170 >>> j.val) % 2 == 1
def tetN (y : ℕ) : Bool := (165 >>> (y / 3)) % 2 == 1
def msN (y : ℕ) : Bool := (170 >>> ((y - 24) / 2)) % 2 == 1

/-- All edges unflipped. -/
def HA (s : Cube) : Prop := ∀ j, s.eo j = 0
/-- ... and the four `E`-slice edges stay in the `E` slice. -/
def HS (s : Cube) : Prop := HA s ∧ ∀ j, (8 ≤ (s.ep j).val ↔ 8 ≤ j.val)
/-- ... and all corners untwisted: this is `⟨U, D, R2, L2, F2, B2⟩`. -/
def HC (s : Cube) : Prop := HS s ∧ ∀ i, s.co i = 0
/-- ... and the corner tetrads and the `M` slice are preserved. -/
def HD (s : Cube) : Prop := HC s ∧ (∀ i, tetF (s.cp i) = tetF i) ∧ ∀ j, msF (s.ep j) = msF j
/-- ... and all corners are solved. -/
def HE (s : Cube) : Prop := HD s ∧ ∀ i, s.cp i = i

theorem HA.mul {x y : Cube} (hx : HA x) (hy : HA y) : HA (x * y) := fun j => by
  simp [hx _, hy j]
theorem HS.mul {x y : Cube} (hx : HS x) (hy : HS y) : HS (x * y) :=
  ⟨hx.1.mul hy.1, fun j => by
    rw [Cube.mul_ep, Equiv.Perm.mul_apply]; exact (hx.2 _).trans (hy.2 j)⟩
theorem HC.mul {x y : Cube} (hx : HC x) (hy : HC y) : HC (x * y) :=
  ⟨hx.1.mul hy.1, fun i => by simp [hx.2 _, hy.2 i]⟩
theorem HD.mul {x y : Cube} (hx : HD x) (hy : HD y) : HD (x * y) :=
  ⟨hx.1.mul hy.1, fun i => by
    rw [Cube.mul_cp, Equiv.Perm.mul_apply]; exact (hx.2.1 _).trans (hy.2.1 i), fun j => by
    rw [Cube.mul_ep, Equiv.Perm.mul_apply]; exact (hx.2.2 _).trans (hy.2.2 j)⟩
theorem HE.mul {x y : Cube} (hx : HE x) (hy : HE y) : HE (x * y) :=
  ⟨hx.1.mul hy.1, fun i => by
    rw [Cube.mul_cp, Equiv.Perm.mul_apply, hy.2 i, hx.2 i]⟩

def cTrue (_ _ : ℕ) : Bool := true
def cNA (_ y : ℕ) : Bool := !(Nat.ble 24 y) || (y % 2 == 0)
def cNS (b y : ℕ) : Bool := cNA b y && (!(Nat.ble 24 y) || (Nat.ble 40 y == Nat.ble 40 b))
def cNC (b y : ℕ) : Bool := cNS b y && (Nat.ble 24 y || y % 3 == 0)
def cND (b y : ℕ) : Bool := cNC b y && (if 24 ≤ y then msN y == msN b else tetN y == tetN b)
def cNE (b y : ℕ) : Bool := cND b y && (Nat.ble 24 y || y == b)

def gN1 (_ y : ℕ) : ℕ := if 24 ≤ y then (y % 2) * 2 ^ ((y - 24) / 2) else 0
def gN2a (_ y : ℕ) : ℕ := if 24 ≤ y then 0 else (y % 3) * 4 ^ (y / 3)
def gN2b (b y : ℕ) : ℕ := if 40 ≤ b then 2 ^ ((y - 24) / 2) else 0
def gN3 (b y : ℕ) : ℕ :=
  if 24 ≤ b then (if msN b then 256 * 2 ^ ((y - 24) / 2) else 0) else (if tetN b then 2 ^ (y / 3) else 0)
def gN4 (b y : ℕ) : ℕ := if 24 ≤ b then 0 else (y / 3) * 8 ^ (b / 3)
def gN5 (b y : ℕ) : ℕ := if 24 ≤ b then ((y - 24) / 2) * 16 ^ ((b - 24) / 2) else 0

theorem fA : ∀ (j c : Fin 12) (o : ZMod 2), cNA (cb (.inr j)) (codeOf (.inr (c, o))) = true → o = 0 := by
  decide
theorem fS : ∀ (j c : Fin 12) (o : ZMod 2), cNS (cb (.inr j)) (codeOf (.inr (c, o))) = true →
    (8 ≤ c.val ↔ 8 ≤ j.val) := by decide
theorem fC : ∀ (i c : Fin 8) (o : ZMod 3), cNC (cb (.inl i)) (codeOf (.inl (c, o))) = true → o = 0 := by
  decide
theorem fD1 : ∀ (i c : Fin 8) (o : ZMod 3), cND (cb (.inl i)) (codeOf (.inl (c, o))) = true →
    tetF c = tetF i := by decide
theorem fD2 : ∀ (j c : Fin 12) (o : ZMod 2), cND (cb (.inr j)) (codeOf (.inr (c, o))) = true →
    msF c = msF j := by decide
theorem fE : ∀ (i c : Fin 8) (o : ZMod 3), cNE (cb (.inl i)) (codeOf (.inl (c, o))) = true →
    c = i := by decide

theorem memA {s : Cube} (h : memG cNA s) : HA s := fun j => by
  simpa [img, act, base] using fA j _ _ (h (.inr j))
theorem memS {s : Cube} (h : memG cNS s) : HS s :=
  ⟨memA fun p => (Bool.and_eq_true _ _ ▸ h p : _ ∧ _).1, fun j => by
    simpa [img, act, base] using fS j _ _ (h (.inr j))⟩
theorem memC {s : Cube} (h : memG cNC s) : HC s :=
  ⟨memS fun p => (Bool.and_eq_true _ _ ▸ h p : _ ∧ _).1, fun i => by
    simpa [img, act, base] using fC i _ _ (h (.inl i))⟩
theorem memD {s : Cube} (h : memG cND s) : HD s :=
  ⟨memC fun p => (Bool.and_eq_true _ _ ▸ h p : _ ∧ _).1, fun i => by
    simpa [img, act, base] using fD1 i _ _ (h (.inl i)), fun j => by
    simpa [img, act, base] using fD2 j _ _ (h (.inr j))⟩
theorem memE {s : Cube} (h : memG cNE s) : HE s :=
  ⟨memD fun p => (Bool.and_eq_true _ _ ▸ h p : _ ∧ _).1, fun i => by
    simpa [img, act, base] using fE i _ _ (h (.inl i))⟩

/-! Invariance of the keys under the next subgroup. -/

theorem g1c : ∀ (i i' c : Fin 8) (o o' : ZMod 3), gN1 (cb (.inl i)) (codeOf (.inl (c, o))) =
    gN1 (cb (.inl i')) (codeOf (.inl (c, o'))) := by decide
theorem g1e : ∀ (j j' c : Fin 12) (o : ZMod 2), gN1 (cb (.inr j)) (codeOf (.inr (c, o))) =
    gN1 (cb (.inr j')) (codeOf (.inr (c, o))) := by decide
theorem g2ac : ∀ (i i' c : Fin 8) (o : ZMod 3), gN2a (cb (.inl i)) (codeOf (.inl (c, o))) =
    gN2a (cb (.inl i')) (codeOf (.inl (c, o))) := by decide
theorem g2ae : ∀ (j j' c : Fin 12) (o : ZMod 2), gN2a (cb (.inr j)) (codeOf (.inr (c, o))) =
    gN2a (cb (.inr j')) (codeOf (.inr (c, o))) := by decide
theorem g2bc : ∀ (i i' c : Fin 8) (o o' : ZMod 3), gN2b (cb (.inl i)) (codeOf (.inl (c, o))) =
    gN2b (cb (.inl i')) (codeOf (.inl (c, o'))) := by decide
theorem g2be : ∀ (j j' c : Fin 12) (o : ZMod 2), (8 ≤ j'.val ↔ 8 ≤ j.val) →
    gN2b (cb (.inr j)) (codeOf (.inr (c, o))) = gN2b (cb (.inr j')) (codeOf (.inr (c, o))) := by decide
theorem g3c : ∀ (i i' c : Fin 8) (o : ZMod 3), tetF i' = tetF i →
    gN3 (cb (.inl i)) (codeOf (.inl (c, o))) = gN3 (cb (.inl i')) (codeOf (.inl (c, o))) := by decide
theorem g3e : ∀ (j j' c : Fin 12) (o : ZMod 2), msF j' = msF j →
    gN3 (cb (.inr j)) (codeOf (.inr (c, o))) = gN3 (cb (.inr j')) (codeOf (.inr (c, o))) := by decide
theorem g4e : ∀ (j j' c : Fin 12) (o : ZMod 2), gN4 (cb (.inr j)) (codeOf (.inr (c, o))) =
    gN4 (cb (.inr j')) (codeOf (.inr (c, o))) := by decide

theorem inv1 (x y : Cube) (hy : HA y) : keyG gN1 (x * y) = keyG gN1 x :=
  keyG_mul gN1 x y (fun i c o => g1c _ _ _ _ _) (fun j c o => by rw [hy j, add_zero]; exact g1e _ _ _ _)
theorem inv2s (x y : Cube) (hy : HS y) : keyG gN2b (x * y) = keyG gN2b x :=
  keyG_mul gN2b x y (fun i c o => g2bc _ _ _ _ _)
    (fun j c o => by rw [hy.1 j, add_zero]; exact g2be _ _ _ _ (hy.2 j))
theorem inv2c (x y : Cube) (hy : HC y) : keyG gN2a (x * y) = keyG gN2a x :=
  keyG_mul gN2a x y (fun i c o => by rw [hy.2 i, add_zero]; exact g2ac _ _ _ _)
    (fun j c o => by rw [hy.1.1 j, add_zero]; exact g2ae _ _ _ _)
theorem inv3 (x y : Cube) (hy : HD y) : keyG gN3 (x * y) = keyG gN3 x :=
  keyG_mul gN3 x y (fun i c o => by rw [hy.1.2 i, add_zero]; exact g3c _ _ _ _ (hy.2.1 i))
    (fun j c o => by rw [hy.1.1.1 j, add_zero]; exact g3e _ _ _ _ (hy.2.2 j))
theorem inv4 (x y : Cube) (hy : HE y) : keyG gN4 (x * y) = keyG gN4 x :=
  keyG_mul gN4 x y (fun i c o => by rw [hy.1.1.2 i, add_zero, hy.2 i])
    (fun j c o => by rw [hy.1.1.1.1 j, add_zero]; exact g4e _ _ _ _)

/-! ### The squares-group level: a key built from 4-sets of corners

The twelve 4-sets in `quadL` (two corners of each tetrad, forming "matching" pairs) are permuted
among themselves by the corner permutations of the squares group. -/

def quadL : List (List (Fin 8)) := [[0,1,2,3], [0,1,4,5], [0,1,6,7], [0,2,4,6], [0,3,4,7], [0,3,5,6], [1,2,4,7], [1,2,5,6], [1,3,5,7], [2,3,4,5], [2,3,6,7], [4,5,6,7]]
def quadLN : List (List ℕ) := [[0,3,6,9], [0,3,12,15], [0,3,18,21], [0,6,12,18], [0,9,12,21], [0,9,15,18], [3,6,12,21], [3,6,15,18], [3,9,15,21], [6,9,12,15], [6,9,18,21], [12,15,18,21]]

def quadF : Finset (Finset (Fin 8)) := (quadL.map List.toFinset).toFinset

/-- The corner permutation of `y` permutes the twelve 4-sets. -/
def PQ (y : Cube) : Prop := quadF.image (fun S => S.image y.cp) = quadF

instance (y : Cube) : Decidable (PQ y) :=
  inferInstanceAs (Decidable (quadF.image (fun S => S.image y.cp) = quadF))

def qkey (s : Cube) : ℕ := (quadL.map (fun S => 2 ^ ((S.map (fun i => 2 ^ (s.cp i).val)).sum))).sum

theorem qkey_eq (s : Cube) : qkey s = ∑ T ∈ quadF, 2 ^ (∑ i ∈ T, 2 ^ (s.cp i).val) := by
  unfold qkey quadF
  rw [List.sum_toFinset _ (by decide : (quadL.map List.toFinset).Nodup), List.map_map]
  congr 1

theorem qkey_mul (x y : Cube) (hy : PQ y) : qkey (x * y) = qkey x := by
  rw [qkey_eq, qkey_eq]
  have h1 : ∀ T : Finset (Fin 8), ∑ i ∈ T, 2 ^ ((x * y).cp i).val =
      ∑ j ∈ T.image y.cp, 2 ^ (x.cp j).val := by
    intro T
    rw [Finset.sum_image (fun a _ b _ h => y.cp.injective h)]
    rfl
  simp only [h1]
  conv_rhs => rw [← hy]
  rw [Finset.sum_image (fun a _ b _ h => Finset.image_injective y.cp.injective h)]

theorem PQ.mul {x y : Cube} (hx : PQ x) (hy : PQ y) : PQ (x * y) := by
  unfold PQ at *
  have : (fun S : Finset (Fin 8) => S.image (x * y).cp) =
      (fun S => S.image x.cp) ∘ (fun S => S.image y.cp) := by
    funext S
    simp only [Function.comp, Finset.image_image]
    rfl
  rw [this, ← Finset.image_image, hy, hx]

theorem PQ_of_cp {y : Cube} (h : ∀ i, y.cp i = i) : PQ y := by
  unfold PQ
  have : (fun S : Finset (Fin 8) => S.image y.cp) = id := by
    funext S; ext j; simp [h]
  rw [this, Finset.image_id]

/-- `HD` together with the 4-set condition: the corner positions are those of the squares group. -/
def HD3 (s : Cube) : Prop := HD s ∧ PQ s

theorem HD3.mul_HE {x y : Cube} (hx : HD3 x) (hy : HE y) : HD3 (x * y) :=
  ⟨hx.1.mul hy.1, hx.2.mul (PQ_of_cp hy.2)⟩

noncomputable def qkeyT (tr : ℕ → ℕ) : ℕ :=
  (quadLN.map (fun S => 2 ^ ((S.map (fun b => 2 ^ (tr b / 3))).sum))).sum

noncomputable def qkeyW (w : List ℕ) : ℕ := qkeyT (trackN w)

theorem quadLN_eq : quadLN = quadL.map (fun S => S.map (fun i => cb (.inl i))) := by decide

theorem track_div (w : List ℕ) (i : Fin 8) : trackN w (cb (.inl i)) / 3 = ((evalW w).cp i).val := by
  rw [trackN_cb]
  show (3 * ((evalW w).cp i).val + ((evalW w).co i + 0).val) / 3 = _
  have h := ZMod.val_lt ((evalW w).co i + 0)
  omega

theorem qkeyW_spec (w : List ℕ) : qkeyW w = qkey (evalW w) := by
  unfold qkeyW qkeyT qkey
  rw [quadLN_eq, List.map_map]
  congr 1
  refine List.map_congr_left fun S _ => ?_
  have : ((fun b => 2 ^ (trackN w b / 3)) ∘ fun i : Fin 8 => cb (Sum.inl i)) =
      fun i => 2 ^ ((evalW w).cp i).val := by
    funext i; simp only [Function.comp, track_div]
  simp only [Function.comp, List.map_map]
  rw [← this]

/-- Key for the cosets of the squares-group pattern inside `⟨U,D,R2,L2,F2,B2⟩`. -/
def K3 (s : Cube) : ℕ := keyG gN3 s + 65536 * qkey s
noncomputable def K3T (tr : ℕ → ℕ) : ℕ := keyT gN3 tr + 65536 * qkeyT tr

theorem K3T_spec (w : List ℕ) : K3T (trackN w) = K3 (evalW w) := by
  show keyW gN3 w + 65536 * qkeyW w = _
  rw [keyW_spec, qkeyW_spec]; rfl

theorem inv3' (x y : Cube) (hy : HD3 y) : K3 (x * y) = K3 x := by
  unfold K3; rw [inv3 x y hy.1, qkey_mul x y hy.2]

