    exact ⟨⟨reachable_one, (dist_le []).trans (by simp)⟩, fun p _ => fix_one p⟩
  obtain ⟨P19, h19, c19⟩ := chain_step (fixedL basePts 19) (basePts.getD 19 (.inl 0)) 0 T19 T19_ok _ _ h20
