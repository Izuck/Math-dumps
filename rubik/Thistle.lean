/-- **God's number is at most 53.** -/
theorem godsNumber_le_53 : godsNumber ≤ 53 :=
  (godsNumber_le_iff _).mpr fun _ hs => dist_le_53 hs

/-- **God's number of the 3x3x3 cube in the half-turn metric lies in `[18, 53]`.** -/
theorem godsNumber_mem_Icc : 18 ≤ godsNumber ∧ godsNumber ≤ 53 :=
  ⟨eighteen_le_godsNumber, godsNumber_le_53⟩

